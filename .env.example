# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Postgres connection string. Works with Neon, Supabase, Vercel Postgres, or a
# Postgres server you run yourself. Tables are created automatically on the
# first request, so nothing else is needed to get started.
#   Hosted:     postgresql://user:password@host/dbname?sslmode=require
#   Self-hosted: postgresql://user:password@localhost:5432/devteam
DATABASE_URL=

# Password for /dashboard. Pick something long — it is the only thing standing
# between the public internet and your clients' contact details.
DASHBOARD_PASSWORD=

# Random secret used to sign the dashboard session cookie and to salt the IP
# hashes used for rate limiting. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Public URL of the site. Used for canonical URLs, Open Graph tags and the
# sitemap. Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://kodenvia.com
